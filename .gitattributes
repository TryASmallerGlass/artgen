# Normalize line endings for all text files
* text=auto

# Force Unix LF for C++ and CMake source
*.cpp  text eol=lf
*.h    text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary outputs (should never be committed, but just in case)
*.png  binary
*.tiff binary
*.tif  binary
*.lib  binary
*.exe  binary
*.dll  binary
